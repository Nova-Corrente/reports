# Copie para infra/local/.env (já ignorado pelo git). Valores só para o ambiente local.

# Portas no host (só em 127.0.0.1)
APP_PORT=3100
DB_PORT=5433
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101

# Versões das imagens de apoio
POSTGRES_VERSION=17
MINIO_IMAGE=coollabsio/minio:latest

# Postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reports
DATABASE_URL=postgresql://postgres:postgres@db:5432/reports

# Auth.js. AUTH_URL é o endereço que o navegador usa; gere outro segredo com: openssl rand -base64 32
AUTH_SECRET=troque-por-um-segredo-local
AUTH_URL=http://localhost:3100
NEXT_PUBLIC_URL_APP=http://localhost:3100

# Endereço que o Puppeteer usa para abrir o /reportviewer por dentro do container (igual à produção)
URL_APP=http://localhost:3000

# MinIO. O endpoint é o host interno da rede Docker, como em produção
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=LOCAL
STORAGE_BUCKET=nc-reports
STORAGE_PATH=
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin123
